{
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi-application-specific-configuration/master/schema.json",
  "manage_rules": [],
  "float_rules": [
    { "kind": "Title", "id": "Settings",      "matching_strategy": "Equals" },
    { "kind": "Title", "id": "Save As",       "matching_strategy": "Equals" },
    { "kind": "Title", "id": "Open",          "matching_strategy": "Equals" },
    { "kind": "Class", "id": "OperationStatusWindow", "matching_strategy": "Equals" }
  ],
  "initial_workspace_rules": [
    { "kind": "Exe", "id": "msedge.exe",      "matching_strategy": "Equals", "monitor": 0, "workspace": 0 },
    { "kind": "Exe", "id": "firefox.exe",     "matching_strategy": "Equals", "monitor": 0, "workspace": 0 },
    { "kind": "Exe", "id": "pycharm64.exe",   "matching_strategy": "Equals", "monitor": 0, "workspace": 1 },
    { "kind": "Exe", "id": "Cursor.exe",      "matching_strategy": "Equals", "monitor": 0, "workspace": 1 },
    { "kind": "Exe", "id": "wezterm-gui.exe", "matching_strategy": "Equals", "monitor": 0, "workspace": 2 }
  ],
  "workspace_rules": [
    { "kind": "Exe", "id": "Discord.exe",     "matching_strategy": "Equals", "monitor": 0, "workspace": 3 },
    { "kind": "Exe", "id": "Spotify.exe",     "matching_strategy": "Equals", "monitor": 0, "workspace": 4 }
  ]
}
